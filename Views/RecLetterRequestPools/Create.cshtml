@model iRecommendWeb.Models.RecLetterRequestPool

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>RecLetterRequestPool</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="poolName" class="control-label">Enter a Name for the Letter Pool/Group</label>
                <input asp-for="poolName" class="form-control" />
                <span asp-validation-for="poolName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="closingDate" class="control-label">Enter a Closing Date for the Pool</label>
                <input asp-for="closingDate" class="form-control" />
                <span asp-validation-for="closingDate" class="text-danger"></span>
            </div>

           

           <br/>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
