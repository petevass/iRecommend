@model iRecommendWeb.Models.RecLetterRequestPool

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>@Html.DisplayFor(model=> model.poolName)</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Letter Pool Name
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.poolName)
        </dd>
    </dl>
    
    <dl class="row">
        <dt class = "col-sm-2">
            Letter PoolClosing Date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.closingDate)
        </dd>
    </dl>

    <dl class="row">
        <dt class = "col-sm-2">
            Number of Recommendation Letter Requests
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.requestIds.Count)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="poolId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
